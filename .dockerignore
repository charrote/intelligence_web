# Exclude large/unnecessary dirs from Docker build context.
# Keep this conservative: existing Dockerfiles COPY intelligence_web/ and
# intelligence_sales/ as whole directories (mcp_server), so only exclude
# clearly junk paths here.
node_modules/
meili_data/
backups/
__pycache__/
*.pyc
.git/
domains/
compose.d/
nginx/dynamic/
crawler_cache/
inbox/
sales_inbox/
*.tar
*.tgz
*.zip
