# Generic domain image — one image serves any number of domains.
# Each domain mounts its own spec.json + data/ directory at runtime.
#
# Build:
#   docker build -f Dockerfile.domain -t intelligence-web-domain-generic .
#
# Run (per domain, via docker-compose.domain-<slug>.yml):
#   docker compose -f docker-compose.domain-<slug>.yml up -d

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Shared core (spec-driven app factory, DB, search, scheduler)
COPY core/ /app/core/

# Generic domain entry point (loads spec from mounted JSON)
COPY generic_domain/api/ /app/api/
COPY generic_domain/wsgi.py /app/wsgi.py

# Dependencies
COPY generic_domain/requirements.txt .
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1

# Default port — overridden per-domain in the compose file
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8766", "--timeout", "120", "wsgi:app"]
