FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY core/ /app/core/
COPY intelligence_sales/api/ /app/api/
COPY intelligence_sales/domain_spec.py /app/domain_spec.py
COPY intelligence_sales/wsgi.py /app/wsgi.py

RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir flask flask-cors gunicorn mcp pydantic uvicorn requests beautifulsoup4 lxml html5lib openpyxl

ENV PYTHONUNBUFFERED=1

CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8767", "--timeout", "120", "wsgi:app"]
